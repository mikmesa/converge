# ---------------------------------------------------------------------------
# Converge environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public (browser) — Supabase project URL and PUBLISHABLE/anon key only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only — Postgres connection as the least-privilege `converge_server`
# role (NOT the service-role key, NOT the postgres superuser).
# Hosted Supabase: use the Supavisor pooler in transaction mode, e.g.
#   postgresql://converge_server.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local:
#   postgresql://converge_server:converge-local-dev@127.0.0.1:54322/postgres
DATABASE_URL=

# Server only — optional. Without it, results still work and the explanation
# area shows "Explanation unavailable right now."
ANTHROPIC_API_KEY=
# Optional override of the explanation model.
ANTHROPIC_MODEL=claude-opus-5
